/* =========================
新規ユーザー登録画面
========================= */

.register-page {
min-height: 100vh;
display: flex;
align-items: center;
justify-content: center;
background: linear-gradient(135deg, #fff8ef 0%, #fff0dc 100%);
padding: 40px 0;
}

.register-card {
width: 720px;
background-color: #ffffff;
border: 1px solid #eadfd4;
border-radius: 26px;
padding: 34px;
box-shadow: 0 8px 24px rgba(90, 60, 40, 0.13);
}

.register-form {
margin: 0;
}

.register-form-grid {
display: grid;
grid-template-columns: repeat(2, 1fr);
gap: 18px 20px;
}

.full-row {
grid-column: span 2;
}
